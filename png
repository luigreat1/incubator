                            </div>
                            <input type="range" id="defense" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> слабее</span>
                                <span>защита</span>
                                <span>сильнее <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>

                        <!-- РАСТЕНИЯ -->
                        <div class="param-group plant-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
                                <span>Глубина корней</span><span id="val-root" class="text-sky-600">5</span>
                            </div>
                            <input type="range" id="root" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> поверхностные</span>
                                <span>корни</span>
                                <span>глубокие <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>
                        <div class="param-group plant-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
                                <span>Потребность в свете</span><span id="val-light" class="text-sky-600">5</span>
                            </div>
                            <input type="range" id="light" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> тень</span>
                                <span>свет</span>
                                <span>яркий свет <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>
                        <div class="param-group plant-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
                                <span>Устойчивость к засухе</span><span id="val-drought-plant" class="text-sky-600">5</span>
                            </div>
                            <input type="range" id="drought-plant" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> боится засухи</span>
