                            </div>
                            <input type="range" id="temp" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> холоднее</span>
                                <span>температура</span>
                                <span>жарче <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>
                        <div class="param-group animal-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
                                <span>Яркий окрас</span><span id="val-color" class="text-sky-600">5</span>
                            </div>
                            <input type="range" id="color" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> тусклый</span>
                                <span>окрас</span>
                                <span>яркий <i class="fa-solid fa-arrow-right"></i></span>
