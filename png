                                    <div class="w-5 h-5 md:w-6 md:h-6 rounded-md md:rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-sun text-[10px] md:text-xs"></i></div>
                                    <div class="text-[9px] md:text-[10px] font-bold text-slate-700">Саванны</div>
