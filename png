                            <label class="selection-box cursor-pointer">
                                <input type="radio" name="zone" value="desert" class="hidden">
                                <div class="p-1.5 md:p-2 rounded-lg md:rounded-xl border border-slate-200 bg-white transition flex items-center gap-1.5 md:gap-2">
                                    <div class="w-5 h-5 md:w-6 md:h-6 rounded-md md:rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-mountain-sun text-[10px] md:text-xs"></i></div>
                                    <div class="text-[9px] md:text-[10px] font-bold text-slate-700">Пустыни</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Среды обитания (Radio) -->
                    <div>
                        <h2 class="text-[10px] md:text-xs font-bold text-sky-800 uppercase mb-1.5 md:mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-layer-group text-sky-500"></i> Среда обитания
                        </h2>
                        <div class="grid grid-cols-2 gap-1.5 md:gap-2">
                            <label class="selection-box cursor-pointer">
                                <input type="radio" name="habitat" value="air" class="hidden">
                                <div class="p-1.5 md:p-2 rounded-lg md:rounded-xl border border-slate-200 bg-white transition flex items-center gap-1.5 md:gap-2">
                                    <div class="w-5 h-5 md:w-6 md:h-6 rounded-md md:rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-feather text-[10px] md:text-xs"></i></div>
                                    <div class="text-[9px] md:text-[10px] font-bold text-slate-700">Воздушная</div>
                                </div>
                            </label>
                            <label class="selection-box cursor-pointer">
                                <input type="radio" name="habitat" value="soil" class="hidden">
                                <div class="p-1.5 md:p-2 rounded-lg md:rounded-xl border border-slate-200 bg-white transition flex items-center gap-1.5 md:gap-2">
                                    <div class="w-5 h-5 md:w-6 md:h-6 rounded-md md:rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center shrink-0"><i class="fa-solid fa-mound text-[10px] md:text-xs"></i></div>
                                    <div class="text-[9px] md:text-[10px] font-bold text-slate-700">Почвенная</div>
                                </div>
                            </label>
                            <label class="selection-box cursor-pointer">
                                <input type="radio" name="habitat" value="water" class="hidden">
                                <div class="p-1.5 md:p-2 rounded-lg md:rounded-xl border border-slate-200 bg-white transition flex items-center gap-1.5 md:gap-2">
                                    <div class="w-5 h-5 md:w-6 md:h-6 rounded-md md:rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-water text-[10px] md:text-xs"></i></div>
                                    <div class="text-[9px] md:text-[10px] font-bold text-slate-700">Водная</div>
                                </div>
                            </label>
                            <label class="selection-box cursor-pointer">
                                <input type="radio" name="habitat" value="organism" class="hidden">
                                <div class="p-1.5 md:p-2 rounded-lg md:rounded-xl border border-slate-200 bg-white transition flex items-center gap-1.5 md:gap-2">
                                    <div class="w-5 h-5 md:w-6 md:h-6 rounded-md md:rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-bacterium text-[10px] md:text-xs"></i></div>
                                    <div class="text-[9px] md:text-[10px] font-bold text-slate-700">Другой организм</div>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <button id="start-sim-btn" class="w-full py-3 md:py-4 bg-sky-500 hover:bg-sky-400 text-white font-bold rounded-xl md:rounded-2xl shadow-lg shadow-sky-200 transition text-sm md:text-lg tracking-wide flex items-center justify-center gap-2 md:gap-3 font-oswald uppercase mt-1 md:mt-2">
                    <i class="fa-solid fa-play"></i> Запустить симуляцию
                </button>
            </section>

            <!-- RIGHT PANEL: VISUALIZER -->
            <section class="xl:col-span-7 flex flex-col gap-3 md:gap-4">
                <div class="glass-panel w-full h-[400px] md:h-[650px] relative overflow-hidden border-2 border-sky-200 flex flex-col items-center justify-center bg-slate-50/50">
                    
                    <!-- CANVAS ДЛЯ МАТРИЦЫ -->
                    <canvas id="matrix-canvas" class="absolute inset-0 w-full h-full opacity-40 z-0 pointer-events-none"></canvas>

                    <!-- TOP HUD -->
                    <div class="absolute top-2 md:top-4 left-2 md:left-4 right-2 md:right-4 z-10 flex justify-between items-start pointer-events-none">
                        <div class="bg-white/90 backdrop-blur border border-sky-200 px-2 py-1 md:px-4 md:py-2 rounded-lg md:rounded-xl text-[9px] md:text-xs font-bold text-sky-800 shadow-sm flex flex-wrap items-center gap-1 md:gap-2 max-w-[60%] md:max-w-[70%]">
                            <span id="hud-zone-icon" class="text-cyan-500"><i class="fa-solid fa-earth-americas"></i></span>
                            <span id="hud-zone-name">Зона не выбрана</span>
                            <span class="text-slate-300">|</span>
                            <span id="hud-habitat-name" class="text-slate-600">Среда не выбрана</span>
                        </div>
                        <div id="sim-status" class="hidden bg-amber-400 text-slate-900 px-2 py-1 md:px-4 md:py-2 rounded-lg md:rounded-xl font-bold text-[9px] md:text-xs shadow-lg animate-pulse flex items-center gap-1 md:gap-2 shrink-0">
                            <i class="fa-solid fa-satellite-dish"></i> Анализ: <span id="timer-text">3.0s</span>
                        </div>
                    </div>

                    <!-- ЦЕНТРАЛЬНАЯ КАРТИНКА ПИТОМЦА (ПРОЗРАЧНОСТЬ 50%) -->
                    <img id="large-species-image" src="" alt="Питомец" class="max-h-[50%] md:max-h-[55%] max-w-[80%] object-contain drop-shadow-2xl z-10 mt-8 md:mt-6">
                    
                    <!-- ЦИФРОВОЙ ТЕКСТ ПОД КАРТИНКОЙ -->
                    <div id="digital-text-container" class="digital-text-container absolute bottom-16 md:bottom-24 z-20 text-center w-full px-4 pointer-events-none">
                        <p id="digital-desc-text" class="font-mono text-sm md:text-lg font-bold text-sky-600 bg-white/80 backdrop-blur px-4 py-2 rounded-xl border border-sky-300 shadow-md inline-block">
                            <!-- Текст добавляется через JS -->
                        </p>
                    </div>

                    <!-- Плашка "Анализ" поверх картинки -->
                    <div id="analysis-overlay" class="absolute inset-0 bg-white/40 backdrop-blur-sm hidden flex-col items-center justify-center z-30">
                        <div class="w-10 h-10 md:w-16 md:h-16 border-4 border-sky-400 border-t-transparent rounded-full animate-spin mb-2 md:mb-4"></div>
                        <div class="text-sky-900 font-bold text-sm md:text-xl font-oswald uppercase">Симуляция среды...</div>
                    </div>

                    <!-- BOTTOM HUD -->
                    <div class="absolute bottom-2 md:bottom-4 left-2 md:left-4 right-2 md:right-4 z-10 flex justify-between items-end pointer-events-none">
                        <div class="text-[8px] md:text-[10px] font-mono text-sky-300 tracking-widest">
                            SYS.ONLINE // TERRA-5
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <script>
        // --- START SCREEN LOGIC ---
        function startLab() {
            document.getElementById('intro-screen').classList.add('hidden');
            document.getElementById('lab-app').classList.remove('hidden');
            document.getElementById('lab-app').classList.add('flex');
            initMatrix();
        }

        function backToIntro() {
            document.getElementById('lab-app').classList.add('hidden');
            document.getElementById('lab-app').classList.remove('flex');
            document.getElementById('intro-screen').classList.remove('hidden');
        }

        // --- MATRIX EFFECT (Мелкие голубые цифры) ---
        function initMatrix() {
            const canvas = document.getElementById('matrix-canvas');
            const ctx = canvas.getContext('2d');
            
            function resizeCanvas() {
                canvas.width = canvas.parentElement.clientWidth;
                canvas.height = canvas.parentElement.clientHeight;
            }
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);

            const letters = '0123456789'.split(''); 
            const fontSize = 10; 
            let columns = canvas.width / fontSize;
            let drops = [];
            
            for (let x = 0; x < columns; x++) {
                drops[x] = 1;
            }

            function draw() {
                ctx.fillStyle = 'rgba(244, 250, 254, 0.15)'; 
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = '#7dd3fc'; 
                ctx.font = fontSize + 'px monospace';

                for (let i = 0; i < drops.length; i++) {
                    const text = letters[Math.floor(Math.random() * letters.length)];
                    ctx.fillText(text, i * fontSize, drops[i] * fontSize);

                    if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                        drops[i] = 0;
                    }
                    drops[i]++;
                }
            }
            
            if (window.matrixInterval) clearInterval(window.matrixInterval);
            window.matrixInterval = setInterval(draw, 50);
        }

        // --- DATA ---
        // ВАЖНО: Убедитесь, что имена файлов в папке img совпадают с этими названиями!
        // "Скорость роста" (growth) УДАЛЕНА из idealParams у всех видов.
        // Описания переписаны так, чтобы дети могли догадаться о зоне и среде.
        const speciesData = [
            { 
                id: 'svetolist', name: 'Светолист', type: 'растение', 
                desc: 'Растёт прямо в воде на мелководье. Его тонкие листья ловят редкие лучи солнца сквозь туман, а слабое свечение помогает насекомым находить его даже в пасмурные дни. Любит прохладу и влагу.',
                idealZone: 'tundra', idealHabitat: 'water', idealParams: { root: 4, light: 2, droughtPlant: 5, waterPlant: 8, tempPlant: 5 },
                texts: {
                    bad: "Не светится, увядает",
                    midle: "Светится слабо, меньше привлекает опылителей",
                    good: "Ярко светится, привлекает опылителей"
                },
                images: {
                    bad: 'img/Svetolist_bad.png',     
                    midle: 'img/Svetolist_midle.png',   
                    good: 'img/Svetolist_good.png'     
                }
            },
            { 
                id: 'gravikus', name: 'Гравикус', type: 'растение', 
                desc: 'Низкий кустик с толстыми листьями. Его длинные корни уходят глубоко в мёрзлый грунт, чтобы добыть воду. Он умеет запасать тепло и переживать сильные морозы. Растёт на камнях и скудной почве.',
                idealZone: 'arctic', idealHabitat: 'soil', idealParams: { root: 9, light: 3, droughtPlant: 9, waterPlant: 2, tempPlant: 2 },
                texts: {
                    bad: "Теряет воду, высыхает",
                    midle: "Удерживает меньше воды, растёт медленно",
                    good: "Удерживает воду и питательные вещества. Активно растёт"
                },
                images: {
                    bad: 'img/Gravikus_bad.png',     
                    midle: 'img/Gravikus_midle.png',   
                    good: 'img/Gravikus_good.png'     
                }
            },
            { 
                id: 'aerocorn', name: 'Аэрокорн', type: 'растение', 
                desc: 'Необычное растение: его корни совсем неглубоко проникают в грунт, а лёгкие семена-парашюты летают в горячем сухом воздухе. Питается пылью и ловит солнечные лучи. Воды ему почти не нужно.',
                idealZone: 'desert', idealHabitat: 'air', idealParams: { root: 2, light: 9, droughtPlant: 10, waterPlant: 1, tempPlant: 9 },
                texts: {
                    bad: "Не получает ветра, вянет и засыхает",
                    midle: "Ловит мало ветра, растёт медленно",
                    good: "Ловит ветер, быстро растёт"
                },
                images: {
                    bad: 'img/Aerocorn_bad.png',     
                    midle: 'img/Aerocorn_midle.png',   
                    good: 'img/Aerocorn_good.png'     
                }
            },
            { 
                id: 'plavunchik', name: 'Плавунчик', type: 'животное', 
                desc: 'Маленькое существо с плавниками и жабрами. Дышит под водой и не может долго находиться на суше — без воды быстро высыхает. Любит тепло и прячется среди густых растений у берега.',
                idealZone: 'rainforest', idealHabitat: 'water', idealParams: { water: 9, temp: 8, color: 6, speed: 7, defense: 3 },
                texts: {
                    bad: "С трудом дышит, почти не движется.",
                    midle: "Плавает медленнее, ослаблен",
                    good: "Активно плавает, здоров и полон сил"
                },
                images: {
                    bad: 'img/Plavunchik_bad.png',     
                    midle: 'img/Plavunchik_midle.png',   
                    good: 'img/Plavunchik_good.png'     
                }
            },
            { 
                id: 'temnushka', name: 'Темнушка', type: 'животное', 
                desc: 'Пушистый зверёк с сильными лапами-лопатами. Почти всю жизнь проводит под землёй: роет длинные ходы и ест корни. Не любит яркий свет и выходит наружу только в сумерках, среди высоких тёмных деревьев.',
                idealZone: 'taiga', idealHabitat: 'soil', idealParams: { water: 4, temp: 5, color: 2, speed: 3, defense: 6 },
                texts: {
                    bad: "Не может рыть ходы, не питается",
                    midle: "Роет меньше ходов, развивается плохо",
                    good: "Роет ходы, питается корнями. Чувствует себя отлично"
                },
                images: {
                    bad: 'img/Temnushka_bad.png',     
                    midle: 'img/Temnushka_midle.png',   
                    good: 'imgTemnushka_good.png'     
                }
            },
            { 
                id: 'vertolet', name: 'Ветролёт', type: 'животное', 
                desc: 'Лёгкое существо с большими крыльями. Живёт в воздухе и почти не садится на землю — на земле его крылья намокают и ломаются. Любит открытые пространства, где много ветра и солнца, и парит над травой.',
                idealZone: 'savanna', idealHabitat: 'air', idealParams: { water: 2, temp: 7, color: 8, speed: 10, defense: 4 },
                texts: {
                    bad: "Крылья повреждены, не может летать",
                    midle: "Летает с трудом, быстро устаёт",
                    good: "Свободно летает, дышит воздухом, наслаждается простором"
                },
                images: {
                    bad: 'img/Vertolet_bad.png',     
                    midle: 'img/Vertolet_midle.png',   
                    good: 'img/Vertolet_good.png'     
                }
            }
        ];

        let selectedSpeciesIndex = 0;
        let speciesStates = speciesData.map(() => 'midle');
        
        let state = {
            zone: '',      // теперь одна зона (строка)
            habitat: '',
            isSimulating: false, simTime: 3.0
        };

        // --- UI SETUP ---
        const speciesContainer = document.getElementById('species-container');
        const largeImg = document.getElementById('large-species-image');
        const analysisOverlay = document.getElementById('analysis-overlay');
        const digitalContainer = document.getElementById('digital-text-container');
        const digitalText = document.getElementById('digital-desc-text');

        function renderSpeciesCards() {
            speciesContainer.innerHTML = '';
            speciesData.forEach((item, index) => {
                const card = document.createElement('button');
                card.className = `species-card state-${speciesStates[index]} ${index === selectedSpeciesIndex ? 'active' : ''}`;
                
                card.innerHTML = `
                    <div class="species-name">${item.name}</div>
                `;
                card.addEventListener('click', () => selectSpecies(index));
                speciesContainer.appendChild(card);
            });
        }

        function updateLargeImage() {
            const item = speciesData[selectedSpeciesIndex];
            largeImg.src = item.images[speciesStates[selectedSpeciesIndex]];
            
            // Обновляем текст
            digitalText.textContent = item.texts[speciesStates[selectedSpeciesIndex]];
            digitalContainer.classList.add('show');
        }

        function selectSpecies(index) {
            if (state.isSimulating) return; 

            selectedSpeciesIndex = index;
            const item = speciesData[index];
            
            document.querySelectorAll('.species-card').forEach((c, i) => c.classList.toggle('active', i === index));
            
            document.getElementById('active-species-name').textContent = item.name;
            document.getElementById('active-species-type').textContent = item.type;
            document.getElementById('active-species-desc').textContent = item.desc;

            const animalParams = document.querySelectorAll('.animal-param');
            const plantParams = document.querySelectorAll('.plant-param');

            if (item.type === 'животное') {
                animalParams.forEach(el => el.classList.remove('hidden'));
                plantParams.forEach(el => el.classList.add('hidden'));
            } else {
                animalParams.forEach(el => el.classList.add('hidden'));
                plantParams.forEach(el => el.classList.remove('hidden'));
            }

            document.querySelectorAll('input[type="range"]').forEach(input => {
                input.value = 5;
                const valSpan = document.getElementById(`val-${input.id}`);
                if (valSpan) valSpan.textContent = '5';
            });

            // Временно скрываем текст при смене вида
            digitalContainer.classList.remove('show');
            setTimeout(() => {
                updateLargeImage();
            }, 150);
        }

        document.querySelectorAll('input[type="range"]').forEach(input => {
            input.addEventListener('input', (e) => {
                const valSpan = document.getElementById(`val-${e.target.id}`);
                if (valSpan) valSpan.textContent = e.target.value;
            });
        });

        // Природная зона — теперь радио (одна)
        document.querySelectorAll('input[name="zone"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                state.zone = e.target.value;
                updateHUD();
            });
        });

        document.querySelectorAll('input[name="habitat"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                state.habitat = e.target.value;
                updateHUD();
            });
        });

        function updateHUD() {
            const zones = { arctic: 'Арктика', tundra: 'Тундра', rainforest: 'Влажные леса', taiga: 'Хвойные леса', savanna: 'Саванны', desert: 'Пустыни' };
            const habitats = { air: 'Воздушная', soil: 'Почвенная', water: 'Водная', organism: 'Другой организм' };
            
            const zName = state.zone ? zones[state.zone] : 'Зона не выбрана';
            const hName = state.habitat ? habitats[state.habitat] : 'Среда не выбрана';
            
            document.getElementById('hud-zone-name').textContent = zName;
            document.getElementById('hud-habitat-name').textContent = hName;
        }

        // --- SIMULATION LOGIC ---
        function checkEnvironment() {
            const current = speciesData[selectedSpeciesIndex];

            if (!state.zone || !state.habitat) {
                return { success: false };
            }

            if (state.habitat !== current.idealHabitat) {
                return { success: false };
            }

            if (state.zone !== current.idealZone) {
                return { success: false };
            }

            let matchedParams = 0;
            for (let key in current.idealParams) {
                let inputId = key;
                if (current.type === 'растение') {
                    if (key === 'droughtPlant') inputId = 'drought-plant';
                    if (key === 'waterPlant') inputId = 'water-plant';
                    if (key === 'tempPlant') inputId = 'temp-plant';
                }
                
                const inputEl = document.getElementById(inputId);
                if (inputEl) {
                    const userVal = parseInt(inputEl.value);
                    const idealVal = current.idealParams[key];
                    if (Math.abs(userVal - idealVal) <= 3) {
                        matchedParams++;
                    }
                }
            }

            if (matchedParams < 3) {
                return { success: false };
            }

            return { success: true };
        }

        document.getElementById('start-sim-btn').addEventListener('click', () => {
            if (state.isSimulating) return;
            state.isSimulating = true;
            state.simTime = 3.0;
            
            const statusEl = document.getElementById('sim-status');
            const timerEl = document.getElementById('timer-text');
            statusEl.classList.remove('hidden');
            statusEl.classList.add('flex');
            
            const btn = document.getElementById('start-sim-btn');
            btn.disabled = true;
            btn.classList.add('opacity-50');
            
            analysisOverlay.classList.remove('hidden');
            analysisOverlay.classList.add('flex');

            const timer = setInterval(() => {
                state.simTime -= 0.1;
                timerEl.textContent = `${Math.max(0, state.simTime).toFixed(1)}s`;
                if (state.simTime <= 0) {
                    clearInterval(timer);
                    finishSimulation();
                }
            }, 100);
        });

        function finishSimulation() {
            state.isSimulating = false;
            const statusEl = document.getElementById('sim-status');
            statusEl.classList.add('hidden');
            statusEl.classList.remove('flex');
            
            const btn = document.getElementById('start-sim-btn');
            btn.disabled = false;
            btn.classList.remove('opacity-50');
            
            analysisOverlay.classList.add('hidden');
            analysisOverlay.classList.remove('flex');

            const result = checkEnvironment();

            if (result.success) {
                speciesStates[selectedSpeciesIndex] = 'good';
            } else {
                speciesStates[selectedSpeciesIndex] = 'bad';
            }

            renderSpeciesCards();
            
            // Скрываем старый текст и обновляем на новый с анимацией
            digitalContainer.classList.remove('show');
            setTimeout(() => {
                updateLargeImage();
            }, 150);
        }

        // --- INIT ---
        window.onload = () => {
            renderSpeciesCards();
            selectSpecies(0);
            updateHUD();
        };
    </script>
</body>
