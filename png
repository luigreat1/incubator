<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Лаборатория Чудо-Питомцев | Терра-5</title>
    <link rel="icon" type="image/png" href="img/lui_s.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Nunito:wght@600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        oswald: ['Oswald', 'sans-serif'],
                        nunito: ['Nunito', 'sans-serif'],
                        mono: ['Share Tech Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f4fafe;
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 20px 20px;
            color: #1e293b;
            font-family: 'Nunito', sans-serif;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, .font-oswald {
            font-family: 'Oswald', sans-serif;
        }

        /* Futuristic Range Slider */
        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: transparent;
        }
        input[type=range]:focus { outline: none; }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 8px;
            cursor: pointer;
            background: #e2e8f0;
            border-radius: 4px;
            border: 1px solid #cbd5e1;
        }
        input[type=range]::-webkit-slider-thumb {
            height: 20px;
            width: 20px;
            border-radius: 50%;
            background: #38bdf8;
            border: 2px solid #ffffff;
            cursor: pointer;
            -webkit-appearance: none;
            margin-top: -6px;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.6);
            transition: transform 0.1s ease, box-shadow 0.2s ease;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.9);
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid #e0f2fe;
            box-shadow: 0 10px 25px -5px rgba(14, 165, 233, 0.1);
            border-radius: 20px;
        }

        .species-card {
            border: 2px solid transparent;
            background: white;
            padding: 8px 4px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            height: 100%;
            min-height: 45px;
            overflow: hidden;
            position: relative;
        }
        
        .species-card.state-midle { border-color: #fbbf24; background-color: #fffbeb; }
        .species-card.state-good { border-color: #22c55e; background-color: #f0fdf4; }
        .species-card.state-bad { border-color: #ef4444; background-color: #fef2f2; }

        .species-card.active {
            box-shadow: 0 0 15px rgba(14, 165, 233, 0.5);
            transform: translateY(-2px) scale(1.02);
            z-index: 10;
        }
        .species-card.active::after {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 12px;
            border: 3px solid #0ea5e9;
            pointer-events: none;
        }

        .species-name {
            font-size: 12px;
            font-weight: bold;
            color: #334155;
            line-height: 1.2;
            text-align: center;
            word-break: break-word;
            padding: 0 2px;
        }

        .selection-box input[type="checkbox"]:checked + div,
        .selection-box input[type="radio"]:checked + div {
            border-color: #0ea5e9;
            background: #e0f2fe;
            box-shadow: inset 0 0 0 1px #0ea5e9;
        }

        /* --- СТИЛИ ДЛЯ СТАРТОВОГО ЭКРАНА --- */
        #intro-screen {
            position: fixed;
            inset: 0;
            z-index: 100;
            background-color: #f0f8ff;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 0.5s ease;
        }
        #intro-screen.hidden {
            opacity: 0;
            pointer-events: none;
        }
        .image-container {
            position: relative;
            width: 95%;
            max-width: 1400px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }
        .image-container img {
            width: 100%;
            display: block;
            user-select: none;
            -webkit-user-drag: none;
        }
        .screen-hitbox {
            position: absolute;
            top: 10%;
            left: 43%;
            width: 53%;
            height: 80%;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            background: rgba(0, 191, 255, 0.05);
        }
        .screen-hitbox:hover {
            background: rgba(0, 191, 255, 0.15);
            box-shadow: 0 0 30px rgba(0, 191, 255, 0.4), inset 0 0 20px rgba(0, 191, 255, 0.3);
        }
        .click-hint {
            background: rgba(255, 255, 255, 0.95);
            padding: 15px 30px;
            border-radius: 50px;
            border: 3px solid #00bfff;
            font-family: 'Oswald', sans-serif;
            font-size: 22px;
            color: #0284c7;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px rgba(0, 191, 255, 0.3);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: pulse 2s infinite;
            pointer-events: none;
        }
        .click-hint i { font-size: 24px; color: #00bfff; }
        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 15px rgba(0, 191, 255, 0.4); }
            50% { transform: scale(1.05); box-shadow: 0 0 30px rgba(0, 191, 255, 0.8); }
            100% { transform: scale(1); box-shadow: 0 0 15px rgba(0, 191, 255, 0.4); }
        }
        @media (max-width: 768px) {
            .click-hint { font-size: 14px; padding: 10px 15px; }
            .click-hint i { font-size: 16px; }
        }

        .param-group.hidden {
            display: none;
        }

        /* --- ПОДСКАЗКИ ПОД ПОЛЗУНКАМИ --- */
        .slider-hint {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 9px;
            font-weight: 800;
            color: #94a3b8;
            letter-spacing: 0.2px;
            text-transform: uppercase;
            margin-top: 2px;
            padding: 0 2px;
            gap: 4px;
        }
        .slider-hint i { font-size: 8px; color: #38bdf8; }
        .slider-hint span:nth-child(2) { color: #64748b; flex-shrink: 0; }
        .slider-hint span:first-child,
        .slider-hint span:last-child { display: flex; align-items: center; gap: 3px; }

        /* Стили для речевого пузыря Луи (направлен вниз) */
        .speech-bubble {
            position: relative;
            background: rgba(255, 255, 255, 0.95);
            border: 2px solid #38bdf8;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(14, 165, 233, 0.2);
            backdrop-filter: blur(5px);
        }
        .speech-bubble::after {
            content: '';
            position: absolute;
            bottom: -12px;
            right: 25px;
            border-width: 12px 12px 0;
            border-style: solid;
            border-color: #38bdf8 transparent transparent transparent;
        }
        .speech-bubble::before {
            content: '';
            position: absolute;
            bottom: -9px;
            right: 27px;
            border-width: 10px 10px 0;
            border-style: solid;
            border-color: rgba(255, 255, 255, 0.95) transparent transparent transparent;
            z-index: 1;
        }

        /* Анимация появления цифрового текста */
        .digital-text-container {
            transition: opacity 0.3s ease, transform 0.3s ease;
            opacity: 0;
            transform: translateY(10px);
        }
        .digital-text-container.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* Прозрачность 50% для центральной картинки */
        #large-species-image {
            opacity: 0.5;
            transition: opacity 0.5s ease, transform 0.5s ease;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col p-2 md:p-6">

    <!-- СТАРТОВЫЙ ЭКРАН С КАРТИНКОЙ -->
    <div id="intro-screen">
        <div class="image-container">
            <img src="img/lui_science.png" alt="Лаборатория ученого Луи">
            <div class="screen-hitbox" onclick="startLab()" title="Нажми, чтобы войти в лабораторию">
                <div class="click-hint">
                    <i class="fa-solid fa-hand-pointer"></i>
                    Нажми на экран
                </div>
            </div>
        </div>
    </div>

    <!-- ОСНОВНОЙ ИНТЕРФЕЙС ЛАБОРАТОРИИ -->
    <div id="lab-app" class="hidden flex-col h-full w-full max-w-7xl mx-auto flex-grow">
        
        <!-- HEADER С УЧЕНЫМ ЛУИ -->
        <header class="w-full mb-3 md:mb-4 glass-panel p-3 md:p-4 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-3 relative">
            
            <!-- Левая часть: Кнопка и заголовок -->
            <div class="flex items-center gap-3 md:gap-4 w-full lg:w-auto z-10 shrink-0">
                <button onclick="backToIntro()" class="w-8 h-8 md:w-10 md:h-10 rounded-xl bg-sky-100 text-sky-600 hover:bg-sky-200 flex items-center justify-center transition shrink-0" title="Вернуться назад">
                    <i class="fa-solid fa-arrow-left text-sm md:text-base"></i>
                </button>
                <div>
                    <h1 class="text-lg md:text-2xl font-bold text-sky-900 uppercase tracking-wide flex items-center gap-2">
                        <i class="fa-solid fa-dna text-sky-500"></i> Лаборатория
                    </h1>
                    <p class="text-[10px] md:text-xs text-sky-600 font-semibold">Настройка среды для видов с Терра-5</p>
                </div>
            </div>

            <!-- Правая часть: Ученый Луи и речь -->
            <div class="flex items-end self-end lg:self-auto z-10 mt-2 lg:mt-0 w-full lg:w-auto justify-end">
                <div class="speech-bubble p-3 md:p-4 mr-2 max-w-[280px] sm:max-w-[400px] lg:max-w-[500px]">
                    <p class="text-[11px] md:text-sm font-semibold text-slate-700 leading-tight md:leading-snug flex items-start gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-amber-500 mt-0.5 animate-pulse"></i>
                        <span>«Земляне, в опасности <span class="text-rose-500 font-bold whitespace-nowrap">шесть видов</span> с Терра-5. Мне надо создать для них правильную среду для каждого. Помогите!»</span>
                    </p>
                </div>
<img src="img/lui_s.png" alt="Ученый Луи" class="w-14 h-14 md:w-20 md:h-20 rounded-full object-cover border-2 border-sky-300 shadow-md shrink-0 bg-white">            </div>
            
        </header>

        <div class="grid grid-cols-1 xl:grid-cols-12 gap-3 md:gap-6 flex-grow">
            
            <!-- LEFT PANEL: CONTROLS -->
            <section class="xl:col-span-5 flex flex-col gap-3 md:gap-4">
                
                <!-- SPECIES SELECTION -->
                <div class="glass-panel p-3 md:p-4">
                    <h2 class="text-[10px] md:text-xs font-bold text-sky-800 uppercase mb-2 md:mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-list-ul text-sky-500"></i> Выбор вида (6)
                    </h2>
                    <div id="species-container" class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        <!-- JS Populated -->
                    </div>
                </div>

                <!-- DESCRIPTION -->
                <div class="glass-panel p-3 md:p-4">
                    <div class="flex items-center justify-between mb-1 md:mb-2 flex-wrap gap-2">
                        <span id="active-species-name" class="font-bold text-base md:text-lg text-sky-900 font-oswald uppercase">...</span>
                        <span id="active-species-type" class="text-[9px] md:text-[10px] font-bold bg-sky-100 text-sky-700 px-2 py-0.5 rounded uppercase tracking-wider">...</span>
                    </div>
                    <p id="active-species-desc" class="text-xs md:text-sm font-semibold text-slate-600 leading-snug">
                        ...
                    </p>
                </div>

                <!-- PARAMETERS (DYNAMIC) -->
                <div class="glass-panel p-3 md:p-4">
                    <h2 class="text-[10px] md:text-xs font-bold text-sky-800 uppercase mb-2 md:mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-sky-500"></i> Параметры
                    </h2>
                    <div class="space-y-2 md:space-y-3" id="params-container">
                        
                        <!-- ЖИВОТНЫЕ -->
                        <div class="param-group animal-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
                                <span>Потребность в воде</span><span id="val-water" class="text-sky-600">5</span>
                            </div>
                            <input type="range" id="water" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> меньше</span>
                                <span>вода</span>
                                <span>больше <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>
                        <div class="param-group animal-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
