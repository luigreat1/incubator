                                <span>стойкий к засухе <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>
                        <div class="param-group plant-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
                                <span>Потребность в воде</span><span id="val-water-plant" class="text-sky-600">5</span>
                            </div>
                            <input type="range" id="water-plant" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> меньше</span>
                                <span>вода</span>
                                <span>больше <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>
                        <div class="param-group plant-param space-y-1 hidden">
                            <div class="flex justify-between text-[10px] md:text-xs font-bold text-slate-600">
                                <span>Температурный диапазон</span><span id="val-temp-plant" class="text-sky-600">5</span>
                            </div>
                            <input type="range" id="temp-plant" min="1" max="10" value="5" step="1">
                            <div class="slider-hint">
                                <span><i class="fa-solid fa-arrow-left"></i> холоднее</span>
                                <span>температура</span>
                                <span>жарче <i class="fa-solid fa-arrow-right"></i></span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ENVIRONMENT SELECTION -->
                <div class="glass-panel p-3 md:p-4 flex flex-col gap-3 md:gap-4">
                    
                    <!-- Природная зона (Radio — одна) -->
