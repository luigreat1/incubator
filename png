                                <div class="p-1.5 md:p-2 rounded-lg md:rounded-xl border border-slate-200 bg-white transition flex items-center gap-1.5 md:gap-2">
                                    <div class="w-5 h-5 md:w-6 md:h-6 rounded-md md:rounded-lg bg-green-50 text-green-700 flex items-center justify-center shrink-0"><i class="fa-solid fa-tree-city text-[10px] md:text-xs"></i></div>
                                    <div class="text-[9px] md:text-[10px] font-bold text-slate-700">Хвойные леса</div>
                                </div>
                            </label>
                            <label class="selection-box cursor-pointer">
                                <input type="radio" name="zone" value="savanna" class="hidden">
